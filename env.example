GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL=postgresql://job_agent:job_agent@localhost:5434/job_agent

# Токен від @BotFather (/newbot у Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Твій chat_id - дізнаєшся, написавши боту /start (він сам покаже), тоді встав сюди
TELEGRAM_CHAT_ID=
# Необов'язково: як часто (в годинах) бот сам перевіряє нові вакансії. За замовчуванням 4.
CHECK_INTERVAL_HOURS=4
